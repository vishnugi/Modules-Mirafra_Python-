    "nums = [1,4,2,5]\n",
    "l=min(nums)\n",
    "h=max(nums)\n",
    "mis=[]\n",
    "for i in range(l,h+1):\n",
    "    if i not in nums:\n",
    "        mis.append(i)\n",
    "print(mis)\n",
    "        \n"
